# WinTux: GdiskOS-base rootfs retargeted at a portable Windows-side VM.
# Autologin to a plain bash on tty1, dropbear SSH on :22, 9P host-filesystem
# support, standard Linux tooling for working with Windows files.

# Architecture: x86_64 (64-bit UEFI cannot boot a 32-bit kernel; BOOTX64.EFI target)
BR2_x86_64=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_GLIBC_STABLE=y

# System
BR2_TARGET_GENERIC_HOSTNAME="wintux"
BR2_TARGET_GENERIC_ISSUE=""
BR2_TARGET_GENERIC_ROOT_PASSWD=""
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="board/wintux/overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/wintux/post-build.sh"

# mkfs.fat converts volume labels through codepage 850

# Autologin: busybox getty on tty1, run WinTux launcher as root (no gdisk-panel)
BR2_TARGET_GENERIC_GETTY_PORT="tty1"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_KEEP=y
BR2_TARGET_GENERIC_GETTY_TERM="linux"
BR2_TARGET_GENERIC_GETTY_OPTIONS="-n -l /usr/local/bin/wintux-launch"

# Kernel: arch default config + our fragment (adds 9P, virtio-console)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_USE_ARCH_DEFAULT_CONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/wintux/linux.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# Busybox (bash + wget want SHOW_OTHERS)
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="board/wintux/busybox.fragment"

# Core userspace
BR2_PACKAGE_BASH=y
BR2_PACKAGE_NCURSES_TARGET_PROGS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_UTIL_LINUX_LOSETUP=y
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
BR2_PACKAGE_UTIL_LINUX_MOUNTPOINT=y
BR2_PACKAGE_UTIL_LINUX_WIPEFS=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_NTFS_3G_NTFSPROGS=y
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_CIFS_UTILS=y
BR2_PACKAGE_RSYNC=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_KBD=y

# Comfort tools for bash-in-Windows
BR2_PACKAGE_NANO=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_TMUX=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_CA_CERTIFICATES=y

# SSH server (dropbear): auto-starts via /etc/init.d/S50dropbear, config in /etc/default/dropbear
BR2_PACKAGE_DROPBEAR=y

# GRUB2: keep BIOS+UEFI targets so the same rootfs can also be delivered as an ISO/USB image
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_X86_64_EFI=y
BR2_TARGET_GRUB2_INSTALL_TOOLS=y

# Images: cpio.xz initrd (the QEMU path uses this directly) + bootable ISO (for USB)
# BR2_TARGET_ROOTFS_TAR is not set
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_XZ=y
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_GRUB2=y
BR2_TARGET_ROOTFS_ISO9660_BOOT_MENU="board/wintux/grub.cfg"
