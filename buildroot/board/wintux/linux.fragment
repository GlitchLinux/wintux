CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_XZ=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_ISO9660_FS=y
CONFIG_JOLIET=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_PIIX=y
CONFIG_BLK_DEV_NVME=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI_VIRTIO=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
# 9P stays in the kernel for forward-compat, but Windows QEMU builds have
# virtfs stripped (upstream QEMU refuses to build it outside Linux/macOS/BSD),
# so 9P is dead weight on Windows. CIFS is the actual Windows host-share
# transport: VM mounts //10.0.2.2/WinTux (SLIRP gateway) over SMB2/3.
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_CIFS=y
CONFIG_CIFS_DEBUG=n
CONFIG_CIFS_UPCALL=n
CONFIG_CIFS_XATTR=n
CONFIG_CIFS_POSIX=n
# QEMU fw_cfg sysfs: host passes WinTux CIFS creds via
# -fw_cfg name=opt/wintux/creds,file=... which the guest reads at
# /sys/firmware/qemu_fw_cfg/by_name/opt/wintux/creds/raw
CONFIG_FW_CFG_SYSFS=y
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_FUSE_FS=y
CONFIG_PACKET=y
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_IGB=y
CONFIG_R8169=y
CONFIG_TIGON3=y
# UEFI boot: GOP framebuffer console (VGA text console only exists on BIOS)
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
